ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
POSTGRES_USER=mf_user
POSTGRES_PASSWORD=mf_password
POSTGRES_DB=mf_platform
POSTGRES_HOST=db
POSTGRES_PORT=5432
